# Copy to .env and fill in.

# FAL — for the flat-lay desk background behind the iPhone frame
# (fal-ai/gpt-image-1, ~$0.19/run). Required only if you generate the background
# with scripts/gen-flat-lay-bg.py; skip if you supply your own assets/flat-lay-bg.jpg.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — OPTIONAL. Only if you generate the music bed via the ElevenLabs
# music API instead of dropping your own lofi/hip-hop loop at audio/music-bed.mp3.
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
