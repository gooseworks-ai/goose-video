# Copy to .env and fill in. Both keys are required.

# FAL — for nano-banana (character anchors + scene keyframes) and Seedance Pro (image-to-video).
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — for eleven_v3 TTS and the music API.
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
