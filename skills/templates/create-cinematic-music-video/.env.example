# Copy to .env and fill in. Both keys are required.

# FAL — for nano-banana (beat-locked keyframes) and Seedance Pro (image-to-video).
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — for the Music API (original anthem + word-level timestamps).
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
