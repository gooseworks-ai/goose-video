# ─────────────────────────────────────────────────────────────────────────────
# create-ugc-style-video — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your .env file.
# ─────────────────────────────────────────────────────────────────────────────

# FAL API key — required for avatar generation (NB2), scene generation (Seedance),
# and transcription (Whisper). Get yours at https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# ElevenLabs API key — required for music bed generation via the Sound Generation API.
# Optional if you supply your own royalty-free music track.
# Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Klap API key — optional. Used for enhanced caption styling instead of ffmpeg drawtext.
# Get yours at https://klap.app
# KLAP_API_KEY=your_klap_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Output configuration (optional overrides)
# ─────────────────────────────────────────────────────────────────────────────

# Directory for all output files (default: ./output)
# OUTPUT_DIR=./output

# Default resolution: 1080p or 720p (720p = budget mode, ~50% lower cost)
# DEFAULT_RESOLUTION=1080p

# Music mix level in dB below VO (default: -18)
# MUSIC_MIX_DB=-18
